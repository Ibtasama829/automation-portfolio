        "messages": {
          "values": [
            {
              "content": "=You write the first reply to a new lead for a small business. Write a warm, professional email reply of at most 120 words.\n\nRules:\n- Reply in the same language the lead wrote in.\n- Use their first name.\n- Respond only to what they actually wrote. Do not assume or praise anything they did not mention (for example growth, success or size).\n- Do not describe our own company, experience, clients or results. Simply say we would be glad to help.\n- Suggest a short call as the next step, without proposing a specific day or time.\n- If the message is empty or vague, thank them and ask one simple question about what they need.\n- Never invent prices, dates, guarantees or facts.\n- Sign off as \"The team\".\n- Output only the email body, no subject line.\n\nLead details:\nName: {{ $json.Name }}\nCompany: {{ $json.Company }}\nMessage: {{ $json.Message }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
